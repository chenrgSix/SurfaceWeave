{
  "name": "surfaceweave",
  "version": "0.0.0",
  "private": true,
  "description": "A protocol-first runtime for agent-generated, tool-driven UI",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:release": "pnpm release:check && node scripts/audit-release-packages.mjs",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "build:tauri": "pnpm --filter @surfaceweave/tea-purchase-tauri tauri:build",
    "check:tauri": "pnpm --filter @surfaceweave/tea-purchase-tauri tauri:check",
    "dev": "pnpm --filter @surfaceweave/tea-purchase dev",
    "dev:tauri": "pnpm --filter @surfaceweave/tea-purchase-tauri tauri:dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "pnpm lint:code && pnpm lint:format",
    "lint:code": "eslint . --max-warnings 0",
    "lint:format": "prettier --check .",
    "release:check": "node scripts/sync-release-metadata.mjs --check",
    "release:sync": "node scripts/sync-release-metadata.mjs --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:packages": "node scripts/verify-package-tarballs.mjs",
    "verify:published-consumers": "node scripts/verify-package-tarballs.mjs --published --tag next",
    "verify:published": "node scripts/verify-published-packages.mjs",
    "verify:release": "pnpm audit:release && node scripts/verify-npm-publish-dry-run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
