{
  "name": "package-first-dynamic-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Package-first, framework-agnostic conversational dynamic UI SDK",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:tauri": "pnpm --filter @package-first/tea-purchase-tauri tauri:build",
    "check:tauri": "pnpm --filter @package-first/tea-purchase-tauri tauri:check",
    "dev": "pnpm --filter @package-first/tea-purchase dev",
    "dev:tauri": "pnpm --filter @package-first/tea-purchase-tauri tauri:dev",
    "lint": "pnpm lint:code && pnpm lint:format",
    "lint:code": "eslint . --max-warnings 0",
    "lint:format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:packages": "node scripts/verify-package-tarballs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
