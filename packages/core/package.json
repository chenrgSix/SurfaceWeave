{
  "name": "@surfaceweave/core",
  "version": "0.1.0-rc.4",
  "description": "Framework-agnostic protocols and runtime for SurfaceWeave",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenrgSix/SurfaceWeave.git",
    "directory": "packages/core"
  }
}
