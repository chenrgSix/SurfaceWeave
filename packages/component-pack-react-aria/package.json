{
  "name": "@surfaceweave/react-aria",
  "version": "0.1.0-rc.1",
  "description": "Accessible React Aria bindings for the SurfaceWeave semantic UI protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@surfaceweave/core": "0.1.0-rc.1",
    "@surfaceweave/react": "0.1.0-rc.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20",
    "react-aria-components": ">=1.20.0 <2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenrgSix/SurfaceWeave.git",
    "directory": "packages/component-pack-react-aria"
  }
}
