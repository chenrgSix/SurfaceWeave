{
  "name": "@package-first/agent-tools",
  "version": "0.1.0",
  "description": "Framework-agnostic Agent tool definitions and handlers for Dynamic UI",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
