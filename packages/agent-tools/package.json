  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@package-first/core": "workspace:*",
    "@package-first/generator": "workspace:*",
    "@package-first/preferences": "workspace:*"
  },
  "devDependencies": {
    "@package-first/storage": "workspace:*"
  }
}
