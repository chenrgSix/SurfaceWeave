{
  "name": "@package-first/generator",
  "version": "0.1.0",
  "description": "Deterministic schema-driven Surface generator",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@package-first/core": "workspace:*"
  }
}
