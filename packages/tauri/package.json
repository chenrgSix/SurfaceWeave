{
  "name": "@surfaceweave/tauri",
  "version": "0.3.0",
  "description": "Controlled Tauri 2 adapters for SurfaceWeave",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
