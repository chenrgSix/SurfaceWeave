{
  "name": "@package-first/tauri",
  "version": "0.3.0",
  "description": "Controlled Tauri 2 adapters for Package First Dynamic UI",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@package-first/core": "workspace:*",
    "@package-first/preferences": "workspace:*",
    "@package-first/storage": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.4.0"
  }
}
