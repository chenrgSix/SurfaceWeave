{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic UI Tea Purchase",
  "version": "0.3.0",
  "identifier": "dev.package-first.tea-purchase",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dynamic UI Tea Purchase",
        "width": 1280,
        "height": 860,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1421 ws://127.0.0.1:1421; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
