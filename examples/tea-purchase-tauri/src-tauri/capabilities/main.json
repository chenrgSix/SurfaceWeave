{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum local permissions for the Dynamic UI tea example.",
  "windows": ["main"],
  "permissions": [
    "allow-dynamic-ui-commands",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save"
  ]
}
